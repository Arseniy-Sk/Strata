<Window x:Class="Browser.DevToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Tools - {Binding CurrentUrl}"
        Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B">

    <Window.Resources>
        <Style x:Key="DevToolsTab" TargetType="TabItem">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DevToolsButton" TargetType="Button">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#333333" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh" Style="{StaticResource DevToolsButton}" Click="RefreshButton_Click"/>
                <Button Content="Clear Console" Style="{StaticResource DevToolsButton}" Click="ClearConsoleButton_Click"/>
                <Button Content="View Source" Style="{StaticResource DevToolsButton}" Click="ViewSourceButton_Click"/>
                <Button Content="Inspect Element" Style="{StaticResource DevToolsButton}" Click="InspectElementButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <TabControl Grid.Row="1" Background="#1E1E1E" BorderThickness="0">
            <TabItem Header="Console" Style="{StaticResource DevToolsTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Renamed to avoid conflict -->
                    <TextBox x:Name="ConsoleOutputTextBox" Grid.Row="0" 
                            Background="#1E1E1E" Foreground="#CCCCCC" 
                            FontFamily="Consolas" FontSize="12"
                            IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                            Text="{Binding ConsoleOutputText}"/>

                    <Border Grid.Row="1" Background="#333333" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ConsoleInputTextBox" Grid.Column="0" 
                                    Background="#404040" Foreground="White" 
                                    FontFamily="Consolas" FontSize="12"
                                    Padding="8" BorderThickness="0"
                                    KeyDown="ConsoleInput_KeyDown"/>

                            <Button Grid.Column="1" Content="Execute" 
                                   Style="{StaticResource DevToolsButton}"
                                   Click="ExecuteButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Elements" Style="{StaticResource DevToolsTab}">
                <TextBox x:Name="HtmlViewerTextBox" 
                        Background="#1E1E1E" Foreground="#CCCCCC" 
                        FontFamily="Consolas" FontSize="12"
                        IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                        Text="{Binding PageSourceText}"/>
            </TabItem>

            <TabItem Header="Network" Style="{StaticResource DevToolsTab}">
                <DataGrid x:Name="NetworkRequestsDataGrid" 
                         Background="#1E1E1E" Foreground="#CCCCCC"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         ItemsSource="{Binding NetworkRequests}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>