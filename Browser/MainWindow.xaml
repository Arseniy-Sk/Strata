<Window x:Class="Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Browser.Core"
        Title="Strata" Width="1320" Height="840" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Icon="Assets/strata.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <core:DepthToWidthConverter x:Key="DepthToWidth"/>
        <core:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <core:NullToVisibilityConverter x:Key="NullToVis"/>
        <core:RatioToWidthConverter x:Key="RatioToWidth"/>

        <!-- Letter icon or favicon -->
        <DataTemplate x:Key="FavTemplate">
            <Grid Width="18" Height="18">
                <Border CornerRadius="5" Background="{Binding HueBrush}"
                        Visibility="{Binding HasFavicon, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="{Binding Letter}" Foreground="{Binding HueForeground}" FontSize="9.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image Source="{Binding Favicon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- Tab tree row -->
        <DataTemplate x:Key="TabRowTemplate">
            <Border x:Name="Row" Padding="{DynamicResource TabRowPadding}" CornerRadius="9" Margin="0,1"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                    ToolTip="{Binding Url}" ToolTipService.InitialShowDelay="900">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="{Binding Depth, Converter={StaticResource DepthToWidth}}">
                        <Border x:Name="Guide" Width="9" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,3,0"
                                BorderBrush="{DynamicResource Hair2}" BorderThickness="1,0,0,1" CornerRadius="0,0,0,6"/>
                    </Grid>

                    <Grid Grid.Column="1" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FavTemplate}"/>
                        <Ellipse x:Name="Spinner" Width="18" Height="18" StrokeThickness="2" Visibility="Collapsed"
                                 Stroke="{DynamicResource Accent}" StrokeDashArray="10 20" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinRotate"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Host}" Style="{StaticResource Mono}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AudioButton" Style="{StaticResource SmallClose}" Tag="audio" FontSize="10" Margin="0,0,2,0"
                                Content="&#xE767;" ToolTip="Sound" Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock x:Name="SleepIcon" Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource Faint}" Margin="2,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"
                                   ToolTip="Sleeping — not using memory"/>
                        <Button x:Name="Badge" Tag="collapse" Focusable="False" Cursor="Hand" Margin="0,0,3,0"
                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" ToolTip="Collapse or expand branch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" CornerRadius="5" Padding="5,1" Background="{DynamicResource Well}">
                                        <TextBlock x:Name="T" Text="{Binding Children.Count}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{DynamicResource Dim}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover2}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource SmallClose}" Tag="close"
                            ToolTip="Close (Ctrl W)" Visibility="Hidden" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Depth}" Value="0">
                    <Setter TargetName="Guide" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/>
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsAsleep}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.62"/>
                    <Setter TargetName="SleepIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="AudioButton" Property="Content" Value="&#xE74F;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInSplit}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Hair}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Hair2}"/>
                    <Setter TargetName="Row" Property="Opacity" Value="1"/>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Text}"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="Medium"/>
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinRotate" Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Palette item / address bar suggestion -->
        <DataTemplate x:Key="PaletteItemTemplate">
            <Grid>
                <TextBlock x:Name="Header" Text="{Binding Title}" Style="{StaticResource Caps}" Margin="10,10,10,6" Visibility="Collapsed"/>
                <Border x:Name="Item" CornerRadius="10" Padding="10,8" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" Margin="0,0,11,0" VerticalAlignment="Center">
                            <Border CornerRadius="5" Background="{Binding HueBrush}"
                                    Visibility="{Binding HasFavicon, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock x:Name="Glyph" Text="{Binding Letter}" Foreground="{Binding HueForeground}" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                   Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Mono}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Mono}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="Header" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Item" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIcon}" Value="True">
                    <Setter TargetName="Glyph" Property="FontFamily" Value="{StaticResource IconFont}"/>
                    <Setter TargetName="Glyph" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover2}"/>
                </DataTrigger>
                <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusRow" Height="26"/>
        </Grid.RowDefinitions>

        <!-- ================= Window title bar ================= -->
        <Border x:Name="TitleBar" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentPresenter ContentTemplate="{StaticResource LogoMark}" Content="{Binding}" Margin="0,0,9,0"/>
                    <TextBlock Text="S T R A T A" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" Height="24" Content="&#xE700;" FontSize="12"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Tab sidebar (Ctrl B)" Click="SidebarToggle_Click"/>

                    <Border x:Name="SpacePill" Margin="10,0,0,0" Padding="7,3,9,3" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource Well}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                            WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="SpacePill_Click"
                            ToolTip="Switch space (Ctrl Alt → / ←)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding Tabs.ActiveSpace.Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Tabs.ActiveSpace.Name}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Tabs.ActiveSpace.TabCount}" Style="{StaticResource Mono}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="SearchPill" Grid.Column="1" MaxWidth="420" Height="24" Margin="10,0" HorizontalAlignment="Left"
                        CornerRadius="8" Background="Transparent" Cursor="IBeam" WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonUp="OpenPalette_Click">
                    <Grid Margin="8,0">
                        <TextBlock Text="Search tabs, sites, or commands" Foreground="{DynamicResource Faint}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="4" Padding="5,1">
                            <TextBlock Text="Ctrl K" Style="{StaticResource Mono}"/>
                        </Border>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Height="24" Content="&#xE706;" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Toggle theme" Click="ThemeToggle_Click" VerticalAlignment="Center"/>
                    <Button x:Name="PanelToggle" Style="{StaticResource IconButton}" Height="24" Content="&#xE70B;" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Notes" Click="PanelToggle_Click" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="54"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="272" MinWidth="0" MaxWidth="480"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="PanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Rail: spaces and library -->
            <Border x:Name="Rail" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,10">
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                        <Button x:Name="RailHistory" Style="{StaticResource RailButton}" Content="&#xE81C;" ToolTip="History and sessions (Ctrl H)" Click="RailHistory_Click" Margin="0,4"/>
                        <Button x:Name="RailDownloads" Style="{StaticResource RailButton}" Content="&#xE896;" ToolTip="Downloads (Ctrl J)" Click="RailDownloads_Click" Margin="0,4"/>
                        <Button x:Name="RailExtensions" Style="{StaticResource RailButton}" Content="&#xEA86;" ToolTip="Extensions" Click="RailExtensions_Click" Margin="0,4"/>
                        <Button x:Name="RailSleep" Style="{StaticResource RailButton}" Content="&#xE708;" ToolTip="Sleep all background tabs (Ctrl Shift S)" Click="SleepAll_Click" Margin="0,4"/>
                        <Button x:Name="RailSettings" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Settings (Ctrl ,)" Click="RailSettings_Click" Margin="0,4"/>
                        <Button x:Name="RailAbout" Style="{StaticResource RailButton}" ToolTip="About Strata" Click="RailAbout_Click" Margin="0,4">
                            <ContentPresenter ContentTemplate="{StaticResource LogoMark}" Content="{Binding}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <ItemsControl x:Name="SpaceList" ItemsSource="{Binding Tabs.Spaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Chip" Width="34" Height="34" CornerRadius="11" Margin="0,0,0,8" Cursor="Hand"
                                            Background="{DynamicResource Well}" ToolTip="{Binding Name}"
                                            MouseLeftButtonUp="SpaceChip_Click" MouseRightButtonUp="SpaceChip_RightClick"
                                            AllowDrop="True" Drop="SpaceChip_Drop">
                                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover2}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{Binding Brush}"/>
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Foreground}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Ghost}" Width="34" Height="34" ToolTip="New space" Click="NewSpace_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="11" Background="Transparent">
                                        <Grid>
                                            <Rectangle RadiusX="11" RadiusY="11" Stroke="{DynamicResource Hair2}" StrokeDashArray="3 2.5" StrokeThickness="1"/>
                                            <TextBlock x:Name="Plus" Text="+" FontSize="15" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Plus" Property="Foreground" Value="{DynamicResource Text}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tab sidebar -->
            <Border x:Name="Sidebar" Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                        <Button x:Name="NewTabButton" Click="NewTab_Click" Height="30" Cursor="Hand" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource AccentSoft}" Padding="10,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="15" Foreground="{DynamicResource AccentText}" Margin="0,-2,8,0"/>
                                                <TextBlock Text="New tab" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentText}"/>
                                            </StackPanel>
                                            <TextBlock Text="Ctrl T" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}"
                                                       Foreground="{DynamicResource AccentText}" Opacity="0.7"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ItemsControl x:Name="PinnedList" ItemsSource="{Binding Tabs.Pinned}" Margin="0,10,0,0"
                                      Visibility="{Binding Tabs.Pinned.Count, Converter={StaticResource NullToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pin" Width="34" Height="34" CornerRadius="10" Margin="0,0,6,6" Cursor="Hand"
                                            Background="{DynamicResource Well}" BorderBrush="Transparent" BorderThickness="1"
                                            ToolTip="{Binding Title}" MouseLeftButtonUp="Pinned_Click" MouseRightButtonUp="Tab_RightClick"
                                            MouseDown="Pinned_MouseDown">
                                        <Grid>
                                            <Border x:Name="Letter" Width="24" Height="24" CornerRadius="7" Background="{Binding HueBrush}"
                                                    Visibility="{Binding HasFavicon, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock Text="{Binding Letter}" Foreground="{Binding HueForeground}" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Favicon}" Width="18" Height="18"
                                                   Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}"/>
                                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{DynamicResource Accent}" HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" Margin="0,3,3,0" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Pin" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pin" Property="Background" Value="{DynamicResource Hover2}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAsleep}" Value="True">
                                            <Setter TargetName="Pin" Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAudible}" Value="True">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Pin" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="Pin" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Pin" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Memory card -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hair}" BorderThickness="0,1,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentText}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="MemoryCardText" FontSize="11.5"/>
                                </StackPanel>
                                <Grid x:Name="MemoryTrack" Height="3" Margin="0,7,0,4">
                                    <Border CornerRadius="1.5" Background="{DynamicResource Well}"/>
                                    <Border CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                <Binding Path="Tabs.MemoryRatio"/>
                                                <Binding Path="ActualWidth" ElementName="MemoryTrack"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="MemoryCardSub" Style="{StaticResource Mono}" FontSize="9.5"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE708;" Margin="8,0,0,0"
                                    ToolTip="Sleep all background tabs" Click="SleepAll_Click"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18,6,16,4">
                            <TextBlock Text="TAB TREE" Style="{StaticResource Caps}"/>
                            <TextBlock x:Name="CollapseAllText" Text="COLLAPSE" Style="{StaticResource Caps}" HorizontalAlignment="Right" Cursor="Hand"
                                       MouseLeftButtonUp="CollapseAll_Click"/>
                        </Grid>
                        <ListBox x:Name="TabList" Grid.Row="1" Style="{StaticResource BareList}" Padding="8,0,8,12"
                                 ItemsSource="{Binding Tabs.ActiveSpace.VisibleTabs}" ItemTemplate="{StaticResource TabRowTemplate}"
                                 PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown" PreviewMouseMove="TabList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp" PreviewMouseDown="TabList_PreviewMouseDown"
                                 MouseRightButtonUp="TabList_MouseRightButtonUp" MouseDoubleClick="TabList_MouseDoubleClick"
                                 AllowDrop="True" DragOver="TabList_DragOver" Drop="TabList_Drop" DragLeave="TabList_DragLeave"/>
                        <Canvas Grid.Row="1" IsHitTestVisible="False">
                            <Border x:Name="DropLine" Height="2" CornerRadius="1" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Right" Background="Transparent" Focusable="False"
                          ResizeDirection="Columns" DragCompleted="SidebarSplitter_DragCompleted" x:Name="SidebarSplitter"/>

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ToolbarRow" Height="44"/>
                    <RowDefinition x:Name="BookmarksRow" Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="Toolbar" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back (Alt ←)" Click="Back_Click"
                                        IsEnabled="{Binding Tabs.ActiveTab.CanGoBack, FallbackValue=False}" Margin="0,0,2,0"/>
                                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward (Alt →)" Click="Forward_Click"
                                        IsEnabled="{Binding Tabs.ActiveTab.CanGoForward, FallbackValue=False}" Margin="0,0,2,0"/>
                                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload (F5)" Click="Reload_Click" Margin="0,0,8,0"/>
                            </StackPanel>

                            <Border x:Name="Omnibox" Grid.Column="1" Height="30" CornerRadius="9" Background="{DynamicResource Well}"
                                    BorderBrush="{DynamicResource Hair}" BorderThickness="1" Cursor="IBeam">
                                <Grid Margin="6,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ShieldChip" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                            Background="{DynamicResource AccentSoft}" MouseLeftButtonUp="ShieldChip_Click"
                                            ToolTip="Shield: trackers and ads blocked on this page">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource AccentText}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Tabs.ActiveTab.BlockedCount, FallbackValue=0}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBox x:Name="AddressBox" Grid.Column="1" Style="{StaticResource BareTextBox}" FontFamily="{StaticResource MonoFont}"
                                             FontSize="12" GotKeyboardFocus="AddressBox_GotFocus" LostKeyboardFocus="AddressBox_LostFocus"
                                             PreviewKeyDown="AddressBox_PreviewKeyDown" TextChanged="AddressBox_TextChanged"
                                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="TranslateButton" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="12" Content="&#xF2B7;"
                                                ToolTip="Translate page (Ctrl Alt T)" Click="Translate_Click"/>
                                        <Button x:Name="BookmarkButton" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="12" Content="&#xE734;"
                                                ToolTip="Bookmark (Ctrl D)" Click="Bookmark_Click"/>
                                        <Grid>
                                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11" Content="&#xE896;"
                                                    ToolTip="Downloads (Ctrl J)" Click="RailDownloads_Click"/>
                                            <Ellipse x:Name="DownloadDot" Width="5" Height="5" Fill="{DynamicResource Accent}" HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button x:Name="ReaderButton" Style="{StaticResource ToolbarPill}" Content="Read" ToolTip="Reader mode (Ctrl Alt R)" Click="Reader_Click"/>
                                <Button x:Name="SplitButton" Style="{StaticResource ToolbarPill}" ToolTip="Split screen (Ctrl \)" Click="Split_Click" Margin="2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⊞" FontSize="13" VerticalAlignment="Center" Margin="0,-2,6,0"/>
                                        <TextBlock Text="Split" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TranslatorToolButton" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" FontSize="12" Content="Aa" ToolTip="Translator (Ctrl Alt Y)" Click="TranslatorTool_Click" Margin="0,0,2,0"/>
                                <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu" Click="Menu_Click"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="LoadingBar" Style="{StaticResource LoadingBar}" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                     Visibility="{Binding Tabs.ActiveTab.IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                    </Grid>
                </Border>

                <!-- Bookmarks bar -->
                <Border x:Name="BookmarksBar" Grid.Row="1" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Hair}"
                        BorderThickness="0,0,0,1" Padding="8,3" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="BookmarksBarList" ItemsSource="{Binding Tabs.Bookmarks.Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Chip" CornerRadius="7" Padding="7,4" Margin="1,0" Background="Transparent" Cursor="Hand"
                                            ToolTip="{Binding Url}" MouseLeftButtonUp="BookmarkChip_Click" MouseRightButtonUp="BookmarkChip_RightClick"
                                            MouseDown="BookmarkChip_MouseDown">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding HueBrush}" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding Letter}" Foreground="{Binding HueForeground}" FontSize="8.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="{DynamicResource Read}" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Engine host: all live WebView2 instances stay here permanently, visibility is code-driven -->
                <Grid x:Name="WebHost" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SplitHeaderRow" Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftPane" Width="*"/>
                        <ColumnDefinition x:Name="SplitterPane" Width="0"/>
                        <ColumnDefinition x:Name="RightPane" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LeftHeader" Tag="left" MouseLeftButtonUp="SplitHeader_Click" Cursor="Hand" Padding="12,0"
                            BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Background="{DynamicResource Chrome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FavTemplate}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Host}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                    <Border x:Name="RightHeader" Grid.Column="2" Tag="right" MouseLeftButtonUp="SplitHeader_Click" Cursor="Hand" Padding="12,0"
                            BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Background="{DynamicResource Chrome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FavTemplate}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Host}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                            <Button Grid.Column="3" Style="{StaticResource SmallClose}" ToolTip="Close split" Click="EndSplit_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Focusable="False" Visibility="Collapsed">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border Width="1" Background="{DynamicResource Hair2}"/>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Internal strata:// pages -->
                    <ContentControl x:Name="PageHost" Grid.RowSpan="2" Grid.ColumnSpan="3" Focusable="False" Visibility="Collapsed"/>

                    <!-- Crashed tab -->
                    <StackPanel x:Name="CrashPanel" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="TAB STOPPED" Style="{StaticResource Caps}" HorizontalAlignment="Center"/>
                        <TextBlock Text="The page process has ended" Style="{StaticResource PageTitle}" Margin="0,10,0,8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Other tabs are unaffected — each one runs in its own process." Foreground="{DynamicResource Dim}"
                                   FontSize="13" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource OutlineButton}" Content="Reload" Margin="0,18,0,0" HorizontalAlignment="Center" Click="Reload_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right panel: notes -->
            <Border x:Name="NotesPanel" Grid.Column="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Hair}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Padding="10,9">
                        <Grid>
                            <Border HorizontalAlignment="Left" CornerRadius="7" Padding="10,4" Background="{DynamicResource AccentSoft}">
                                <TextBlock Text="Notes" FontSize="12" Foreground="{DynamicResource AccentText}"/>
                            </Border>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9" Content="&#xE8BB;" HorizontalAlignment="Right"
                                    Click="PanelToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hair}" BorderThickness="0,1,0,0" Padding="10">
                        <Grid>
                            <TextBox x:Name="NoteInput" Style="{StaticResource FieldTextBox}" KeyDown="NoteInput_KeyDown" AcceptsReturn="False"/>
                            <TextBlock Text="New note for this page…" Foreground="{DynamicResource Faint}" FontSize="12" Margin="11,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="{Binding Text, ElementName=NoteInput, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SAVED" Style="{StaticResource Caps}" Margin="14,14,14,10"/>
                        <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemsSource="{Binding Tabs.Notes.Items}" Padding="14,0,14,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="0,0,0,8" Padding="12" CornerRadius="11" Background="{DynamicResource Well}"
                                            BorderBrush="{DynamicResource Hair}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,16,0"/>
                                                <TextBlock Style="{StaticResource Mono}" Margin="0,7,0,0" Cursor="Hand" MouseLeftButtonUp="NoteLink_Click" Tag="{Binding Url}">
                                                    <Run Text="{Binding Host, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding CreatedUtc, Mode=OneWay, StringFormat={}{0:dd.MM HH:mm}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button x:Name="Del" Style="{StaticResource SmallClose}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0" Click="DeleteNote_Click" Visibility="Hidden"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Hair}" BorderThickness="0,1,0,0"
                TextElement.FontFamily="{StaticResource MonoFont}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Tabs.CountText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Tabs.MemoryText}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Tabs.HoverText}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource Dim}"/>
                <TextBlock x:Name="StatusRight" Grid.Column="3" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Floating layers (above the engine HWND) ================= -->
        <Popup x:Name="PalettePopup" Grid.RowSpan="3" PlacementTarget="{Binding ElementName=Root}" Placement="Relative"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="True">
            <Grid x:Name="PaletteBackdrop" Background="{DynamicResource Backdrop}" MouseLeftButtonDown="PaletteBackdrop_MouseDown"
                  Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}">
                <Border x:Name="PaletteCard" Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,40"
                        CornerRadius="16" Background="{DynamicResource PaletteBg}" BorderBrush="{DynamicResource Hair2}" BorderThickness="1"
                        MouseLeftButtonDown="PaletteCard_MouseDown" RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PaletteScale"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="18" Opacity="0.55" Color="{DynamicResource ShadowColor}"/>
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox x:Name="PaletteInput" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="15"
                                         TextChanged="PaletteInput_TextChanged" PreviewKeyDown="PaletteInput_PreviewKeyDown"/>
                                <TextBlock Grid.Column="1" Text="Tabs, history, commands…   # tabs  @ history  &gt; commands" FontSize="15"
                                           Foreground="{DynamicResource Faint}" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Text, ElementName=PaletteInput, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ESC" Style="{StaticResource Mono}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox x:Name="PaletteList" Style="{StaticResource BareList}" MaxHeight="440" Padding="8"
                                 ItemTemplate="{StaticResource PaletteItemTemplate}" PreviewMouseLeftButtonUp="PaletteList_Click"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Popup>

        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=Omnibox}" Placement="Bottom" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
            <Border x:Name="SuggestCard" CornerRadius="12" Background="{DynamicResource PaletteBg}" BorderBrush="{DynamicResource Hair2}"
                    BorderThickness="1" Padding="6" Margin="0,0,14,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <ListBox x:Name="SuggestList" Style="{StaticResource BareList}" MaxHeight="420"
                         ItemTemplate="{StaticResource PaletteItemTemplate}" PreviewMouseLeftButtonUp="SuggestList_Click"/>
            </Border>
        </Popup>

        <Popup x:Name="ToastPopup" PlacementTarget="{Binding ElementName=Root}" Placement="Relative" AllowsTransparency="True"
               StaysOpen="True" PopupAnimation="Fade" IsHitTestVisible="False">
            <Border CornerRadius="10" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Hair2}" BorderThickness="1"
                    Padding="14,9" Margin="10,10,10,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter ContentTemplate="{StaticResource LogoMark}" Content="{Binding}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Floating translator panel — stays above the tab content of any page -->
        <Popup x:Name="TranslatorPopup" PlacementTarget="{Binding ElementName=Root}" Placement="Relative"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Focusable="True">
            <Border x:Name="TranslatorCard" Width="360" CornerRadius="16" Background="{DynamicResource PaletteBg}"
                    BorderBrush="{DynamicResource Hair2}" BorderThickness="1" MouseLeftButtonDown="TranslatorCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="16" Opacity="0.5" Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Padding="14,11"
                            Cursor="SizeAll" MouseLeftButtonDown="TranslatorHeader_MouseDown"
                            MouseMove="TranslatorHeader_MouseMove" MouseLeftButtonUp="TranslatorHeader_MouseUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Translator" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource SmallClose}" Click="TranslatorClose_Click" ToolTip="Close (Esc)"/>
                        </Grid>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="14,12,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TranslatorFrom" Grid.Column="0" Style="{StaticResource ValueCombo}" HorizontalAlignment="Stretch"
                                  SelectionChanged="TranslatorLang_Changed"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="28" Margin="6,0" Content="&#xE895;"
                                FontSize="11" ToolTip="Swap languages" Click="TranslatorSwap_Click"/>
                        <ComboBox x:Name="TranslatorTo" Grid.Column="2" Style="{StaticResource ValueCombo}" HorizontalAlignment="Stretch"
                                  SelectionChanged="TranslatorLang_Changed"/>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hair}" BorderThickness="0,1,0,0" Padding="14,9">
                        <Grid>
                            <TextBlock x:Name="TranslatorStatus" Style="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center"/>
                            <Button Content="Copy translation" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right"
                                    Padding="9,4" FontSize="11" Click="TranslatorCopy_Click"/>
                        </Grid>
                    </Border>

                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Well}" BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <TextBox x:Name="TranslatorInput" Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                         Padding="10" FontSize="13" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                         TextChanged="TranslatorInput_TextChanged" PreviewMouseLeftButtonDown="TranslatorInput_PreviewMouseLeftButtonDown"/>
                                <TextBlock Text="Type or paste text…" FontSize="13" Margin="11,10" Foreground="{DynamicResource Faint}"
                                           IsHitTestVisible="False" VerticalAlignment="Top"
                                           Visibility="{Binding Text, ElementName=TranslatorInput, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Height="10"/>
                        <Border Grid.Row="2" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer Style="{StaticResource SlimScroll}" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                <TextBox x:Name="TranslatorOutput" Style="{StaticResource BareTextBox}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Padding="10" FontSize="13"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
