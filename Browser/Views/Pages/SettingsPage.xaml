<UserControl x:Class="Browser.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,1,0" Padding="12,24">
            <StackPanel>
                <TextBlock Text="SETTINGS" Style="{StaticResource Caps}" FontSize="11" Margin="10,0,0,12"/>
                <ItemsControl x:Name="Nav" Focusable="False"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" Style="{StaticResource SlimScroll}" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Body" MaxWidth="760" HorizontalAlignment="Left" Margin="34,32,34,56" MinWidth="420"/>
        </ScrollViewer>
    </Grid>
</UserControl>
