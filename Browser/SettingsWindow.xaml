<Window x:Class="Browser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Settings" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="SettingGroupStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="SettingButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- General Settings -->
                <GroupBox Header="General Settings" Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <TextBlock Text="Home Page" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="HomePageTextBox" Text="{Binding Settings.HomePage}" 
                                Padding="8" Background="#FAFAFA" BorderBrush="#CCCCCC"/>

                        <CheckBox x:Name="HardwareAccelCheckBox" Content="Enable Hardware Acceleration" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.HardwareAcceleration}"/>

                        <CheckBox x:Name="DoNotTrackCheckBox" Content="Send Do Not Track requests" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.DoNotTrack}"/>

                        <!-- New setting for script errors -->
                        <CheckBox x:Name="SuppressScriptErrorsCheckBox" Content="Suppress Script Error Dialogs" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.SuppressScriptErrors}"
                                 ToolTip="Prevents JavaScript error dialogs from appearing"/>
                    </StackPanel>
                </GroupBox>

                <!-- Privacy & Security -->
                <GroupBox Header="Privacy &amp; Security" Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <CheckBox x:Name="JavaScriptCheckBox" Content="Enable JavaScript" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.EnableJavaScript}"/>

                        <CheckBox x:Name="CookiesCheckBox" Content="Enable Cookies" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.EnableCookies}"/>

                        <CheckBox x:Name="ThirdPartyCookiesCheckBox" Content="Block Third-Party Cookies" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.BlockThirdPartyCookies}"/>

                        <CheckBox x:Name="ImagesCheckBox" Content="Load Images Automatically" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.EnableImages}"/>

                        <CheckBox x:Name="PopupsCheckBox" Content="Block Pop-up Windows" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.BlockPopups}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Data Management -->
                <GroupBox Header="Data Management" Style="{StaticResource SettingGroupStyle}">
                    <StackPanel>
                        <CheckBox x:Name="ClearHistoryCheckBox" Content="Clear History on Exit" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.ClearHistoryOnExit}"/>

                        <CheckBox x:Name="ClearCacheCheckBox" Content="Clear Cache on Exit" 
                                 Style="{StaticResource SettingCheckBox}"
                                 IsChecked="{Binding Settings.ClearCacheOnExit}"/>

                        <Button Content="Clear Browsing Data Now" 
                               Style="{StaticResource SettingButton}"
                               Click="ClearDataButton_Click"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SettingButton}" 
                       Background="#6C757D" Click="CancelButton_Click"
                       MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>

                <Button Content="Save" Style="{StaticResource SettingButton}" 
                       Click="SaveButton_Click"
                       MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>